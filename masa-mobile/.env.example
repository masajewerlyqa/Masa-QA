# ──────────────────────────────────────────────────────────────
# MASA Mobile — Expo environment variables
# Copy to masa-mobile/.env.local (gitignored) and fill in values.
# ──────────────────────────────────────────────────────────────
# IMPORTANT: Only EXPO_PUBLIC_* variables are bundled into the app.
# NEVER put server secrets (service role keys, Stripe secret keys,
# Resend API keys, webhook secrets) in this file.
# Server secrets belong in the Next.js web app's Vercel environment.
# ──────────────────────────────────────────────────────────────

# Supabase — same project as the Next.js web app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Next.js site URL — used for market prices API, contact form, and checkout.
# Development: http://localhost:3000 (rewritten to LAN IP on physical devices)
# Production:  https://masajewelry.com
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (safe for client-side)
# EXPO_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Google Sign-In — Web client ID from Google Cloud Console
# Required for Google auth in Expo Go and production builds.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# OAuth redirect override — only for custom dev build testing.
# Do NOT set this when running in Expo Go (the app auto-detects exp://).
# EXPO_PUBLIC_AUTH_REDIRECT_URI=masa://auth/callback

# App store links (optional — footer icons show disabled when unset)
# EXPO_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id...
# EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# ──────────────────────────────────────────────────────────────
# Supabase redirect URLs to configure (Dashboard → Authentication → URL Configuration):
#   masa://auth/callback
#   masa://**
#   exp://127.0.0.1:8081/--/auth/callback  (Expo Go — check Metro logs)
#
# Stripe mobile checkout deep links (configured server-side):
#   masa://checkout/success
#   masa://checkout/cancel
# ──────────────────────────────────────────────────────────────
