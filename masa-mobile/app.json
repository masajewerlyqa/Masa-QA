{
  "expo": {
    "name": "MASA",
    "slug": "masa-mobile",
    "scheme": "masa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masajewelry.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:masajewelry.com",
        "webcredentials:masajewelry.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "MASA needs camera access to take product photos.",
        "NSPhotoLibraryUsageDescription": "MASA needs photo library access to upload product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#531C24"
      },
      "package": "com.masajewelry.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "masajewelry.com",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "masajewelry.com",
              "pathPrefix": "/checkout"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#531C24"
        }
      ],
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/FILL_IN_PROJECT_ID"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "FILL_IN_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://masajewelry.com/privacy"
    }
  }
}
